# envsubst runs this template through env var substitution at container
# startup (see docker-entrypoint.sh) and writes the result to
# /etc/nginx/conf.d/default.conf. PEOPLE_UPSTREAM / DELIVERY_UPSTREAM /
# API_UPSTREAM default to the docker-compose service names but can be
# overridden without rebuilding the image.
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS, with a short TTL so a redeployed people/delivery/api
    # container (new container, new IP, same service name) is picked up within
    # seconds -- without this, a plain `proxy_pass http://people:80/;` resolves
    # once and nginx keeps proxying to the old IP until Shell itself restarts,
    # even though People and Delivery are supposed to redeploy independently.
    resolver 127.0.0.11 valid=10s;

    # Content-hashed, safe to cache forever; missing ones must 404 rather
    # than falling back to index.html as a 200 text/html response.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # index.html and /config/env.js name the current build/remote URLs and
    # must always be revalidated, or a rebuild can leave the browser
    # holding stale references.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    # People's whole static build (remoteEntry.js + its chunks) is
    # reachable under /people-remote/ on Shell's own origin -- this is
    # what lets the browser fetch it with zero CORS configuration.
    location /people-remote/ {
        # Routing the hostname through a variable is what makes nginx honor
        # the `resolver` above and re-look-up the address per request instead
        # of caching it once at startup -- but a variable proxy_pass loses
        # nginx's automatic location-prefix stripping, so `rewrite ... break`
        # strips /people-remote/ ourselves before proxying bare (no URI part
        # on proxy_pass, which is what makes the rewritten URI apply).
        set $people_upstream http://${PEOPLE_UPSTREAM};
        rewrite ^/people-remote/(.*)$ /$1 break;
        proxy_pass $people_upstream;
        proxy_http_version 1.1;
    }

    location /delivery-remote/ {
        set $delivery_upstream http://${DELIVERY_UPSTREAM};
        rewrite ^/delivery-remote/(.*)$ /$1 break;
        proxy_pass $delivery_upstream;
        proxy_http_version 1.1;
    }

    location /api/ {
        set $api_upstream http://${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off; # required so the SSE endpoint streams instead of batching
        proxy_cache off;
    }
}
